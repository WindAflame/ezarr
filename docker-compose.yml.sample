---
name: ezarr

# This is the central toggle file. Comment out a line below to disable that
# entire category of services (requires Docker Compose v2.20+, check with
# `docker compose version`).
# For finer-grained control (e.g. Plex vs Jellyfin, qBittorrent vs SABnzbd),
# keep the category included and instead comment out individual services
# inside the matching file in compose/.
include:
  - compose/servarr.yml
  - compose/indexers.yml
  - compose/media-servers.yml
  - compose/requests.yml
  - compose/download-clients.yml
  - compose/debrid.yml
  - compose/dashboard.yml
  # Uncomment ONE of the three reverse proxies below (traefik / caddy / nginx-proxy-manager):
  # - compose/reverse-proxy.yml
  # SSO provider for Jellyfin (OIDC), ROMM (OIDC) and Arr apps (forward auth via reverse proxy):
  # - compose/sso-authelia.yml
  # - compose/sso-authentik.yml
