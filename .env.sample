# If you're not sure what timezone you should fill in, you can look at the following list:
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Use the column that says "TZ database name".
# To find your system's preconfigured timezone run: cat /etc/timezone
TIMEZONE=Europe/Amsterdam

# Email used by Traefik/Caddy to register Let's Encrypt certificates
ACME_EMAIL=

# Romm — IGDB credentials for game metadata (register at https://api.igdb.com)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Random secret used to sign Romm session tokens — generate with: openssl rand -hex 32
ROMM_AUTH_SECRET_KEY=

# Drop — self-hosted game library/store (compose/media-servers.yml)
# Public URL where Drop is reachable — change for remote access or reverse proxy
DROP_EXTERNAL_URL=http://localhost:3000
# Credentials for Drop's bundled PostgreSQL (internal Docker network only)
DROP_DB_USER=drop
DROP_DB_PASSWORD=drop
DROP_DB_NAME=drop

# Host path where decypharr mounts your debrid (Real-Debrid/AllDebrid/TorBox) library.
# Must exist on the host and be shared (rshared) so Plex/Jellyfin/*arr can read it.
DECYPHARR_MOUNT_PATH=/mnt/debrid

# The PleX claim token is used to connect your server to your account. It can be obtained at
# https://www.plex.tv/claim/ and is valid for 4 minutes after generating the token.
PLEX_CLAIM=

# Choose your root directory for keeping all your container configs and data.
ROOT_DIR=

# USER IDs for each container that requires its own user. Default values will most likely suffice,
# but change any ID that conflicts with an existing user on your system.
# If you've already set up the containers and want to change user IDs after the fact, you have to
# remove the old users first and re-set permissions. First run sources/remove_old_users.sh and
# then re-run sources/setup.sh to rebuild the directory structure and permissions.

# The user used to run docker-compose and for services without a dedicated user
# (jellyfin, tautulli, wizarr, decypharr mount, droposs). To find yours run: id -u
UID=1000

# Shared media group
MEDIACENTER_GID=13000

# Servarr (compose/servarr.yml)
SONARR_UID=13001
RADARR_UID=13002
LIDARR_UID=13003
BAZARR_UID=13013
AUDIOBOOKSHELF_UID=13014
# Note: kapowarr and questarr run as root (PUID=0) — no dedicated UID needed

# Indexers (compose/indexers.yml)
PROWLARR_UID=13006
JACKETT_UID=13008

# Media servers (compose/media-servers.yml)
PLEX_UID=13010
# Note: jellyfin and feishin use ${UID} — no dedicated UID needed
# Note: drop runs as root (no PUID/PGID support) and drop-db (Postgres) uses a named volume — no dedicated UID needed

# Download clients (compose/download-clients.yml)
QBITTORRENT_UID=13007
SABNZBD_UID=13011

# Requests (compose/requests.yml)
# Note: seerr, tautulli and wizarr use ${UID} — no dedicated UID needed

# Debrid (compose/debrid.yml)
# Note: decypharr uses ${UID} (it owns the fuse mount) — no dedicated UID needed

# Legacy — used by sources/setup.sh for system user creation only, not referenced in compose files
MYLAR_UID=13005     # mylar3 replaced by kapowarr in compose files
READARR_UID=13004   # Discontinued
